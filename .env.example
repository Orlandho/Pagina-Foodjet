# Copiar a .env antes de levantar el entorno:  cp .env.example .env

# --- Base de datos ---
POSTGRES_USER=foodjet_user
POSTGRES_PASSWORD=foodjet_password
POSTGRES_DB=FoodjetBackend

# El host es "db", el nombre del servicio en docker-compose, no localhost.
DATABASE_URL="postgresql://foodjet_user:foodjet_password@db:5432/FoodjetBackend?schema=public"

# --- API ---
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
# Generar una con:  openssl rand -base64 48
PORT=3000

# Sembrar datos de demostración al arrancar (idempotente).
RUN_SEED=true

# --- Mapa de la dirección de entrega (Google Maps) ---
# Keys de Google Cloud con "Maps JavaScript API" y "Geocoding API" activadas.
# Se entregan al navegador, así que en Google Cloud hay que restringirlas por
# sitio web (foodjet.asen.pe/* y localhost:8081/*).
# Cascada de prioridad: 1) GOOGLE_MAPS_API_KEY (primaria)  2) GOOGLE_MAPS_API_KEY_SECUNDARIA (respaldo)
# Vacías, el checkout funciona sin mapa: la dirección se escribe a mano y se ubica con el GPS del navegador.
# Tras cambiarlas:  docker compose up -d backend
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_SECUNDARIA=

# --- Reparto en el mapa ---
# Servicio público de enrutamiento sobre OpenStreetMap. Si no responde, la ruta
# cae a línea recta y la simulación sigue funcionando.
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=5000
# Velocidad media del repartidor, para estimar el tiempo de entrega.
REPARTIDOR_VELOCIDAD_KMH=25

# --- Simulación del pedido y del reparto (ver backend/src/domain/simulacion.js) ---
# Cada pedido nuevo avanza solo por sus estados y el repartidor recorre la
# ruta en el mapa del seguimiento. Los pedidos anteriores no se tocan.
SIMULAR_PEDIDOS=true
# Cuántas veces más rápido que la realidad: 10 deja un pedido urbano en unos
# 3 minutos; 1 usa los tiempos reales.
SIM_ESCALA_TIEMPO=10
# Minutos reales de cada etapa (antes de aplicar la escala). El reparto sale
# de la distancia a REPARTIDOR_VELOCIDAD_KMH, con este máximo.
SIM_CONFIRMACION_MIN=2
SIM_PREPARACION_MIN=12
SIM_REPARTO_MAX_MIN=40

# --- Simulación del avance de pedidos (ver backend/src/jobs/) ---
ENABLE_JOBS=false
ORDER_SIMULATION_STEP_MS=15000
AUTO_CANCEL_MINUTES=30

# --- Publicación ---
# Caddy escucha aquí dentro. Detrás del túnel se deja en ":80": el HTTPS lo
# pone Cloudflare y el túnel entrega en claro por la red interna de Docker.
# Con un dominio real aquí, Caddy pediría el certificado por su cuenta.
DOMINIO=:80

# Quién alcanza el proxy directamente. Con el túnel en marcha, 127.0.0.1 hace
# que la única entrada sea Cloudflare. 0.0.0.0 lo abre a la red local.
HTTP_BIND=127.0.0.1
HTTP_PORT=8081

# Túnel de Cloudflare. Se obtiene al crear el túnel en el panel
# (Zero Trust > Networks > Tunnels) y es una credencial: no se versiona.
# Sin él, el servicio "tunel" no arranca; el resto del stack funciona igual.
TUNNEL_TOKEN=
